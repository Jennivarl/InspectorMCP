{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://44.218.148.44:8080/api/:path*" },
    { "source": "/mcp", "destination": "http://44.218.148.44:8080/mcp" },
    { "source": "/health", "destination": "http://44.218.148.44:8080/health" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
